# ==============================================================================
# AgroTech Platform — Environment Configuration Template (.env.example)
# Copy this file to '.env' in the backend/ directory:
#   Windows: copy .env.example .env
#   Linux/Mac: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SECURITY & AUTHENTICATION (JWT)
# ------------------------------------------------------------------------------
# Secret key used to sign and verify JSON Web Tokens.
# Generate a secure 32+ character random string in production:
# e.g., python -c "import secrets; print(secrets.token_hex(32))"


# Token validity duration in minutes (1440 = 24 hours, 10080 = 7 days)
JWT_EXPIRE_MINUTES=1440


# ------------------------------------------------------------------------------
# 2. AI AGRICULTURAL ASSISTANT (Mistral AI)
# ------------------------------------------------------------------------------
# Optional: API key from https://console.mistral.ai/
# If left empty, AgroTech automatically uses its built-in offline
# intelligent Krishi Advisory Engine (Wheat, Fertilizer, Machinery, Schemes).
MISTRAL_API_KEY=


# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (Supabase PostgreSQL / Local SQLite)
# ------------------------------------------------------------------------------
# Optional: Supabase credentials from https://supabase.com/dashboard/project/_/settings/api
# If left empty, the platform runs 100% locally on self-contained SQLite (backend/agrotech.db).
# Never expose the service_role key to frontend JavaScript!
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=


# ------------------------------------------------------------------------------
# 4. EMAIL SERVICE & SMTP (Registration OTP Verification)
# ------------------------------------------------------------------------------
# Optional: Required only for sending real OTP emails to farmers/providers.
# For Gmail, use an App Password (https://myaccount.google.com/apppasswords).
# If unconfigured, the console logs the OTP code for quick local testing.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=no-reply@agrotech.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false


# ------------------------------------------------------------------------------
# 5. OTP SECURITY SETTINGS
# ------------------------------------------------------------------------------
# Lifetime of generated verification OTP in minutes
OTP_EXPIRE_MINUTES=15

# Number of digits in generated verification OTP code (default: 6)
OTP_LENGTH=6

# Maximum verification attempts before OTP is invalidated (default: 5)
OTP_MAX_ATTEMPTS=5


# ------------------------------------------------------------------------------
# 6. CORS (Cross-Origin Resource Sharing)
# ------------------------------------------------------------------------------
# Comma-separated allowed frontend domains/ports.
# Defaults to localhost dev servers (5500, 5501, 8000, 3000).
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:3000,http://localhost:3000


# ------------------------------------------------------------------------------
# 7. SERVER HOST & PORT SETTINGS
# ------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
